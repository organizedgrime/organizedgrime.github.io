---
import { generateSignedUrl } from "../utils/bunny";
import type { Video } from "../utils/sanity";
interface Props {
  video: Video;
}
const { video } = Astro.props;
const embedUrl = generateSignedUrl(video.id);
---
<div style={{ position: "relative", paddingTop: video.vertical ? '177.77%' : '56.25%' }}>
  <iframe src={embedUrl}
      loading="lazy" style={{ border: "none", position: "absolute", top: "0", height: "100%", width: "100%" }}
      allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;" >
  </iframe>
</div>
