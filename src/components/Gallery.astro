---
import type {Gallery} from "../utils/sanity"
import GalleryItem from "./GalleryItem.astro";

interface Props {
  gallery?: Gallery
};

const { gallery } = Astro.props;
---
<section>
  {
  gallery &&
  Array.isArray(gallery) ? gallery.map((item) => <GalleryItem item={item} />) : <p>No Gallery<p/>
  }
</section>
