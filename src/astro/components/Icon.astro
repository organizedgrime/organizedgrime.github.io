---
import type { Icon } from "../utils/sanity";
import { Image } from "astro:assets";

interface Props {
  icon: Icon;
}

const { icon } = Astro.props;

const valid =
  icon && icon.metadata && typeof icon.metadata.inlineSvg === "string";
---

<div>
  {
    valid && (
      <Image
        src={`data:image/svg+xml,${icon.metadata.inlineSvg}`}
        alt={icon.icon}
        inferSize={true}
      />
    )
  }
</div>
