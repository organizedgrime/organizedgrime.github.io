---
import type { Photo, Video } from "../utils/sanity";
import VideoComponent from "./Video.astro";
import PhotoComponent from "./Photo.astro";

interface Props {
  item: Photo | Video;
}

const { item } = Astro.props;
const videoMode = item._type === "bunnyVideo";
const photoMode = item._type === "captionedImage";
---

<div>
  {videoMode && <VideoComponent video={item} />}
  {photoMode && <PhotoComponent photo={item} />}
</div>
