---
import { formatDate } from "../utils";
import { Badge } from "./ui/badge";
import {
  Card as CardComponent,
  CardTitle,
  CardHeader,
  CardDescription,
} from "./ui/card";
import { type Post, type Category, getReference } from "../utils/sanity";
import GalleryItem from "./GalleryItem.astro";
import IconComponent from "./Icon.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const category: Category = await getReference<Category>({
  type: "category",
  ref: post.category._ref,
});
---

<CardComponent className="w-full max-w-sm">
  <CardHeader>
    <CardTitle>
      {post.title}
      <Badge>{category.title}<IconComponent icon={category.icon} /></Badge>
    </CardTitle>
    {
      post.gallery?.length ? (
        <GalleryItem item={post.gallery[0]} />
      ) : (
        <div class="card__cover--none" />
      )
    }
  </CardHeader>
  <CardDescription>
    <div class="flex flex-col gap-6">
      <div class="grid gap-2">
        <a href={`/post/${post.slug.current}`}>
          {post.title}
        </a>
      </div>
      <div class="grid gap-2">
        <p class="card__date">
          {formatDate(post.date)}
        </p>
      </div>
    </div>
  </CardDescription>
</CardComponent>
