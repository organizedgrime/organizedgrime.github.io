---
import { formatDate } from "../utils";
import { Card as CardComponent, CardHeader, CardDescription } from "./ui/card";
import { type Post, type Category, getReference } from "../utils/sanity";
import GalleryItem from "./GalleryItem.astro";
import IconComponent from "./Icon.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const category: Category = await getReference<Category>({
  type: "category",
  ref: post.category._ref,
});
---

<CardComponent className="w-full max-w-sm">
  <CardHeader>
    {
      post.gallery?.length ? (
        <GalleryItem item={post.gallery[0]} />
      ) : (
        <div class="card__cover--none" />
      )
    }
  </CardHeader>
  <CardDescription>
    <a class="card__link" href={`/post/${post.slug.current}`}>
      {post.title}
      {post.icon && <IconComponent icon={post.icon} />}
    </a>
    <p class="card__excerpt">
      {category && <IconComponent icon={category.icon} />}
    </p>
    <p class="card__date">
      {formatDate(post.date)}
    </p>
  </CardDescription>
</CardComponent>
