---
import { formatDate } from "../utils";
import { Badge } from "./ui/badge";
import {
  Card as CardComponent,
  CardTitle,
  CardHeader,
  CardDescription,
  CardAction,
  CardContent,
} from "./ui/card";
import { type Post, type Category, getReference } from "../utils/sanity";
import GalleryItem from "./GalleryItem.astro";
import IconComponent from "./Icon.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const category: Category = await getReference<Category>({
  type: "category",
  ref: post.category._ref,
});
---

<CardComponent className="w-full max-w-sm">
  <CardHeader>
    <CardTitle>
      <a href={`post/${post.slug.current}`}>{post.title}</a>
    </CardTitle>
    <CardAction>
      <Badge className="gap-2"
        >{category.title}<IconComponent icon={category.icon} /></Badge
      >
    </CardAction>
    <CardDescription>
      {formatDate(post.date)}
    </CardDescription>
  </CardHeader>
  <CardContent>
    <div class="flex flex-col gap-6">
      {
        post.gallery?.length ? (
          <GalleryItem item={post.gallery[0]} />
        ) : (
          <div class="card__cover--none" />
        )
      }
    </div>
  </CardContent>
</CardComponent>
